# Copie para .env; nunca versione segredos.
# development = local, staging = ambiente de teste, production = venda (validação estrita).
TRIAGEM_ENV=development
TRIAGEM_PUBLIC_URL=http://localhost:8000
TRIAGEM_SERVICE_NAME=Triagem de Vagas
TRIAGEM_SUPPORT_EMAIL=
TRIAGEM_TERMS_URL=
TRIAGEM_PRIVACY_URL=
TRIAGEM_TERMS_VERSION=2026-09-08

# Gere localmente: python -c "import secrets; print(secrets.token_urlsafe(48))"
TRIAGEM_JWT_SECRET=
TRIAGEM_TOKEN_MINUTES=60
# Produção exige PostgreSQL; postgres:// e postgresql:// também aceitos.
# DATABASE_URL=postgresql+psycopg://usuario:senha@host/banco
# Somente Docker Compose: senha aleatória URL-safe (token_urlsafe).
TRIAGEM_POSTGRES_PASSWORD=

# Mesma origem é o padrão no Docker. Informe origens adicionais somente se necessário.
# TRIAGEM_CORS_ORIGINS=https://app.seudominio.com
# IPs/CIDRs dos proxies que controlam X-Forwarded-For. Nunca use * com acesso direto.
# FORWARDED_ALLOW_IPS=127.0.0.1

# Uma busca por processo; fila persiste no banco. Escale com réplicas de worker.
TRIAGEM_WORKER_MODE=embedded
TRIAGEM_JOB_TIMEOUT_SECONDS=1800
TRIAGEM_MONTHLY_SEARCH_LIMIT=30
TRIAGEM_MONTHLY_ANALYSIS_LIMIT=300

# Gemini: configure projeto com faturamento para currículos de clientes.
# https://aistudio.google.com/apikey — veja política de dados em docs/OPERACAO_SAAS.md
GEMINI_API_KEY=
# Fontes opcionais (confirme autorização comercial com os fornecedores).
JOOBLE_API_KEY=
ADZUNA_APP_ID=
ADZUNA_API_KEY=

# Stripe: preço recorrente, mesmo modo da chave; produção exige sk_live.
# Em staging use sk_test. Checkout e portal usam TRIAGEM_PUBLIC_URL por padrão.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# STRIPE_SUCCESS_URL=https://app.seudominio.com/?assinatura=sucesso
# STRIPE_CANCEL_URL=https://app.seudominio.com/?assinatura=cancelado
# STRIPE_PORTAL_RETURN_URL=https://app.seudominio.com/

# Recuperação de senha por e-mail.
TRIAGEM_SMTP_HOST=
TRIAGEM_SMTP_PORT=587
TRIAGEM_SMTP_USERNAME=
TRIAGEM_SMTP_PASSWORD=
TRIAGEM_SMTP_FROM=
TRIAGEM_SMTP_SECURITY=starttls

# Opcionais do CLI local.
# TRIAGEM_HISTORICO=C:\caminho\historico.json
# TRIAGEM_PERFIL=C:\caminho\perfil.json
# TRIAGEM_CV_BASE=C:\caminho\cv.md
