# Copie para .env (o .env está no .gitignore e nunca deve ser versionado).

# Obrigatória — análise, ranking e geração de material de candidatura.
# Gere uma chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=...

# SaaS — obrigatórias em produção.
# DATABASE_URL=postgresql+psycopg://usuario:senha@host/banco
# TRIAGEM_JWT_SECRET=gere-um-segredo-longo-e-aleatorio
# TRIAGEM_TOKEN_MINUTES=60

# Opcionais — fontes estruturadas de vagas usadas por `triar buscar`.
# Sem elas a busca continua funcionando, só com Google Search Grounding/metabusca.
# https://jooble.org/api/about
JOOBLE_API_KEY=...
# https://developer.adzuna.com/ — as duas credenciais são necessárias juntas
ADZUNA_APP_ID=...
ADZUNA_API_KEY=...

# Opcional — caminho alternativo para o arquivo de histórico.
# TRIAGEM_HISTORICO=C:\caminho\historico.json

# Opcional — perfil criado por `triar configurar`.
# TRIAGEM_PERFIL=C:\caminho\perfil.json

# Opcional — origens permitidas na API (api/app.py), separadas por vírgula.
# Padrão: http://localhost:5173,http://127.0.0.1:5173 (dev do frontend).
# TRIAGEM_CORS_ORIGINS=https://app.exemplo.com
